# Local-only MAI-UI P3 evaluation configuration.
# Copy to .env (which is git-ignored) and fill in real values. The API key is
# read only by gui_agent/evaluation/environment.py and never printed, logged,
# or written into reports/audit artifacts.

# OpenAI-compatible inference endpoint (Zhipu BigModel shown as an example).
MAI_UI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Model name accepted by that endpoint.
MAI_UI_MODEL_NAME=glm-5.3-flash

# Real API key for the remote managed service. Local vLLM-style servers may
# accept any placeholder.
BIGMODEL_API_KEY=fill-me-in
